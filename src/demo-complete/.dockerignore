# Fonctions Fission (gérées et exécutées indépendamment par Fission)
functions/

# Binaires locaux et caches de compilation
bin/
frontend
*.exe
*.test
*.out

# Fichiers de sauvegarde et temporaires
*.bak
*.tmp
*.swp
*~

# Fichiers système
.DS_Store
Thumbs.db
